# Normalize line endings: everything is LF in the repository.
* text=auto eol=lf

# Windows scripts must keep CRLF in the working tree.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Unix scripts and the Maven wrapper must keep LF in the working tree.
mvnw text eol=lf
*.sh text eol=lf

# Binary files: never touch them.
*.png binary
*.PNG binary
*.jpg binary
*.JPG binary
*.gif binary
*.ico binary
*.jar binary
*.sav binary
*.tar binary
*.xz binary
*.zip binary
